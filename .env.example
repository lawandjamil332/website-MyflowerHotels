# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# ---- Database (Railway Postgres) ----
# Railway's Postgres plugin exposes this as DATABASE_URL; either name works.
DATABASE_URI=postgresql://user:password@host:5432/railway

# ---- Payload ----
# A long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# No trailing slash. Locally http://localhost:3000,
# on Railway the https://<project>.railway.app URL, later the real domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Image storage (Railway Storage Bucket, S3-compatible) ----
# Without these, uploads land on the local filesystem and Railway
# wipes them on every rebuild.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1

# ---- Enquiry notifications ----
# Without these, an enquiry sent from the website is saved and nobody is told:
# it waits in the admin panel until somebody opens it. With them, it is emailed
# the moment it arrives.
#
# Any SMTP account works — a Gmail address with an app password, or whatever
# the hotels already use. The site starts normally whether or not these are
# set, and never waits on the mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who the mail appears to come from. Defaults to SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=My Flower Hotels

# Where enquiries go when a hotel has no email of its own and Settings has
# none either. Set at least this one.
ENQUIRY_NOTIFY_EMAIL=

# ---- Misc ----
# Secret used to authenticate scheduled jobs
CRON_SECRET=
# Used to validate draft-preview requests from the admin panel
PREVIEW_SECRET=
