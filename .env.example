# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# ---- Database (Railway Postgres) ----
# Railway's Postgres plugin exposes this as DATABASE_URL; either name works.
DATABASE_URI=postgresql://user:password@host:5432/railway

# ---- Payload ----
# A long random string. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# No trailing slash. Locally http://localhost:3000,
# on Railway the https://<project>.railway.app URL, later the real domain.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Image storage (Railway Storage Bucket, S3-compatible) ----
# Without these, uploads land on the local filesystem and Railway
# wipes them on every rebuild.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=us-east-1

# ---- Enquiry notifications ----
# Without these, an enquiry sent from the website is saved and nobody is told:
# it waits in the admin panel until somebody opens it. With them, it is emailed
# the moment it arrives.
#
# Any SMTP account works — a Gmail address with an app password, or whatever
# the hotels already use. The site starts normally whether or not these are
# set, and never waits on the mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Who the mail appears to come from. Defaults to SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=My Flower Hotels

# Where enquiries go when a hotel has no email of its own and Settings has
# none either. Set at least this one.
ENQUIRY_NOTIFY_EMAIL=

# ---- Misc ----
# Secret used to authenticate scheduled jobs
CRON_SECRET=
# Used to validate draft-preview requests from the admin panel
PREVIEW_SECRET=

# ---- Google Hotel Center ----
# Where My Flower's prices are pushed so they can appear on the Google listing
# beside Booking.com and Agoda. All three come from a Hotel Center account —
# there is nothing to invent here, and without them the site simply does not
# push (it still serves /google/hotels.xml and /google/rates.xml for Google to
# fetch, once the switch in Site settings is on).
#
# With them set, every price typed into the calendar and every booking taken is
# sent to Google within the second, rather than waiting to be collected.
GOOGLE_ARI_ENDPOINT=
GOOGLE_ARI_USERNAME=
GOOGLE_ARI_PASSWORD=

# ---- Visitor analytics ----
# The Google Analytics measurement ID, which looks like G-XXXXXXXXXX. It is
# made at analytics.google.com: create a property for the site, add a Web data
# stream for its address, and the ID is on the stream's page.
#
# Left empty, the site loads nothing and counts nobody — which is deliberate,
# so that pages opened in development and the hundreds opened by the test suite
# never appear in the figures as guests. Set it only on the live deployment.
#
# This is separate from Search Console, which needs nothing set here: the
# verification is already in the site's own code, and it shows the last sixteen
# months at search.google.com/search-console whether this is set or not.
#
# Note that it sets cookies in the visitor's browser, and European law wants a
# visitor's agreement before that. There is no consent banner on the site yet.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Reports a confirmed or cancelled booking to Google from the server, rather
# than trusting the guest's browser to do it. A large share of phones block
# Google's script: without this, those visits are counted and the bookings they
# produced are not, so the site reads as one that cannot sell.
#
# Made in Analytics > Admin > Data streams > the stream > Measurement Protocol
# API secrets > Create. It is a server secret and never reaches the browser,
# which is why it has no NEXT_PUBLIC_ prefix.
#
# Useless on its own — NEXT_PUBLIC_GA_MEASUREMENT_ID has to be set too.
GA_API_SECRET=
